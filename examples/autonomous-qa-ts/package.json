{
  "name": "solari-autonomous-qa",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "fixture": "tsx fixture/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "evaluate": "tsx src/evaluate.ts",
    "test:solari": "QA_SOLARI_TESTS=1 tsx --test test/solari.integration.test.ts",
    "test:browser": "QA_BROWSER_TESTS=1 tsx --test test/browser.integration.test.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "0.1.3",
    "@solarisdk/sdk": "0.1.2",
    "zod": "4.1.5",
    "patchright-core": "1.62.2"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
